{
  "name": "soft-factory-runner",
  "version": "0.2.1-beta.0",
  "description": "A local-first CLI for deterministic, isolated, and recoverable RPIV issue delivery.",
  "main": "dist/index.js",
  "bin": {
    "soft-factory": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "format:check": "prettier --check \"src/**/*.ts\" package.json tsconfig.json eslint.config.mjs jest.config.cjs",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "jest --runInBand --coverage",
    "test:focused": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsburckhardt/soft-factory-runner.git"
  },
  "keywords": [
    "automation",
    "cli",
    "github",
    "rpiv"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jsburckhardt/soft-factory-runner/issues"
  },
  "homepage": "https://github.com/jsburckhardt/soft-factory-runner#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "files": [
    "dist/",
    "assets/official/soft-factory.agent.md",
    "README.md",
    "docs/"
  ]
}
